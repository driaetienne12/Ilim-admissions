export default function sitemap() {
  const base = 'https://admissions.ilimschool.com'
  const now = new Date().toISOString()

  return [
    { url: base, lastModified: now, changeFrequency: 'weekly', priority: 1.0 },
    { url: `${base}/admissions`, lastModified: now, changeFrequency: 'monthly', priority: 0.9 },
    { url: `${base}/waitlist`, lastModified: now, changeFrequency: 'monthly', priority: 0.9 },
    { url: `${base}/programs/early-preschool`, lastModified: now, changeFrequency: 'monthly', priority: 0.85 },
    { url: `${base}/programs/primary`, lastModified: now, changeFrequency: 'monthly', priority: 0.85 },
    { url: `${base}/programs/elementary`, lastModified: now, changeFrequency: 'monthly', priority: 0.85 },
    { url: `${base}/programs/middle-school`, lastModified: now, changeFrequency: 'monthly', priority: 0.85 },
    { url: `${base}/tuition`, lastModified: now, changeFrequency: 'monthly', priority: 0.8 },
    { url: `${base}/faq`, lastModified: now, changeFrequency: 'monthly', priority: 0.8 },
    { url: `${base}/founder`, lastModified: now, changeFrequency: 'yearly', priority: 0.7 },
  ]
}
